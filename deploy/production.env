# 本物の Firebase の設定。合鍵ではない（公開して大丈夫な名前だけ）。
# scripts/setup-github-deploy.sh を Cloud Shell で動かして作ったもの。
# 空のあいだは、GitHub Actions は本物に何も上げない。
FIREBASE_PROJECT_ID=handmade-pet-goods-shop
GCP_WIF_PROVIDER=projects/445998152058/locations/global/workloadIdentityPools/github/providers/github
GCP_DEPLOY_SA=github-deploy@handmade-pet-goods-shop.iam.gserviceaccount.com
